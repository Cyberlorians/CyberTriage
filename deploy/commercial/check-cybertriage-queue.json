{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "title": "Check-CyberTriageQueue",
    "description": "Polls the ForensicCollectQueue Sentinel watchlist on a schedule. Dedupes per MdatpDeviceId (keeps newest EnqueuedTime, deletes older duplicates). Fires the CyberTriage-LiveResponse-Collection playbook only for queued devices with fresh Defender DeviceInfo telemetry. Offline devices remain pending in the watchlist.",
    "author": "Security Engineering"
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "SentinelWorkspaceResourceGroup": {
      "type": "string"
    },
    "SentinelWorkspaceName": {
      "type": "string"
    },
    "SentinelWorkspaceCustomerId": {
      "type": "string"
    },
    "SentinelWorkspaceSubscriptionId": {
      "type": "string",
      "defaultValue": "[subscription().subscriptionId]"
    },
    "WatchlistAlias": {
      "type": "string",
      "defaultValue": "ForensicCollectQueue"
    },
    "PollFrequencyMinutes": {
      "type": "int",
      "defaultValue": 60
    },
    "OnlineWindowMinutes": {
      "type": "int",
      "defaultValue": 60
    }
  },
  "variables": {
    "PlaybookName": "Check-CyberTriageQueue",
    "CollectionPlaybookName": "CyberTriage-LiveResponse-Collection",
    "sentinelConnectionName": "[concat('azuresentinel-', variables('PlaybookName'))]",
    "sentinelConnectionId": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'azuresentinel')]",
    "azureMonitorLogsConnectionName": "[concat('azuremonitorlogs-', variables('PlaybookName'))]",
    "azureMonitorLogsConnectionId": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'azuremonitorlogs')]",
    "armBaseUri": "https://management.azure.com",
    "armAudience": "https://management.azure.com/",
    "logAnalyticsApiBaseUri": "https://api.loganalytics.io",
    "logAnalyticsAudience": "https://api.loganalytics.io",
    "watchlistResourceId": "[concat('/subscriptions/', parameters('SentinelWorkspaceSubscriptionId'), '/resourceGroups/', parameters('SentinelWorkspaceResourceGroup'), '/providers/Microsoft.OperationalInsights/workspaces/', parameters('SentinelWorkspaceName'), '/providers/Microsoft.SecurityInsights/watchlists/', parameters('WatchlistAlias'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('sentinelConnectionName')]",
      "location": "[parameters('location')]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('sentinelConnectionName')]",
        "api": {
          "id": "[variables('sentinelConnectionId')]"
        },
        "parameterValueType": "Alternative"
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('azureMonitorLogsConnectionName')]",
      "location": "[parameters('location')]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('azureMonitorLogsConnectionName')]",
        "api": {
          "id": "[variables('azureMonitorLogsConnectionId')]"
        },
        "parameterValueSet": {
          "name": "managedIdentityAuth",
          "values": {}
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[variables('PlaybookName')]",
      "location": "[parameters('location')]",
      "tags": {
        "purpose": "security-playbook",
        "tool": "cybertriage",
        "component": "queue-poller",
        "trigger-model": "recurrence"
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('sentinelConnectionName'))]",
        "[resourceId('Microsoft.Web/connections', variables('azureMonitorLogsConnectionName'))]"
      ],
      "properties": {
        "state": "Disabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "type": "Object",
              "defaultValue": {}
            },
            "WorkspaceSubscriptionId": {
              "type": "String",
              "defaultValue": "[parameters('SentinelWorkspaceSubscriptionId')]"
            },
            "WorkspaceResourceGroup": {
              "type": "String",
              "defaultValue": "[parameters('SentinelWorkspaceResourceGroup')]"
            },
            "WorkspaceName": {
              "type": "String",
              "defaultValue": "[parameters('SentinelWorkspaceName')]"
            },
            "WorkspaceCustomerId": {
              "type": "String",
              "defaultValue": "[parameters('SentinelWorkspaceCustomerId')]"
            },
            "WatchlistAlias": {
              "type": "String",
              "defaultValue": "[parameters('WatchlistAlias')]"
            },
            "OnlineWindowMinutes": {
              "type": "Int",
              "defaultValue": "[parameters('OnlineWindowMinutes')]"
            },
            "CollectionTriggerUrl": {
              "type": "SecureString"
            }
          },
          "triggers": {
            "Recurrence": {
              "type": "Recurrence",
              "recurrence": {
                "frequency": "Minute",
                "interval": "[parameters('PollFrequencyMinutes')]"
              }
            }
          },
          "actions": {
            "Run_Online_Queue_Query": {
              "type": "ApiConnection",
              "runAfter": {},
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuremonitorlogs']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/queryData",
                "queries": {
                  "subscriptions": "@parameters('WorkspaceSubscriptionId')",
                  "resourcegroups": "@parameters('WorkspaceResourceGroup')",
                  "resourcetype": "Log Analytics Workspace",
                  "resourcename": "@parameters('WorkspaceName')",
                  "query": "let OnlineWindow = @{parameters('OnlineWindowMinutes')}m; let Queue = Watchlist | where WatchlistAlias == '@{parameters('WatchlistAlias')}' | where _DTItemType == 'watchlist-item' | summarize arg_max(TimeGenerated, *) by _DTItemId | where _DTItemStatus != 'Delete' | extend item = parse_json(WatchlistItem) | project ItemId = tostring(_DTItemId), MdatpDeviceId = tostring(item.MdatpDeviceId), DeviceName = tostring(item.DeviceName), IncidentId = tostring(item.IncidentId), TagName = tostring(item.TagName), Status = tostring(item.Status), EnqueuedTime = todatetime(item.EnqueuedTime), Attempts = tostring(item.Attempts), RetryAfterUtc = todatetime(item.RetryAfterUtc) | where isnotempty(MdatpDeviceId) | where isempty(Status) or Status in~ ('Pending', 'Offline', 'FailedRetryable', 'BlockedLiveResponse') | where isnull(RetryAfterUtc) or RetryAfterUtc <= now() | summarize arg_max(EnqueuedTime, *) by MdatpDeviceId; let OnlineDevices = DeviceInfo | where TimeGenerated >= ago(OnlineWindow) | where OnboardingStatus =~ 'Onboarded' | summarize arg_max(TimeGenerated, *) by DeviceId | project MdatpDeviceId = tostring(DeviceId), DefenderDeviceName = tostring(DeviceName), LastSeen = TimeGenerated, SensorHealthState = tostring(SensorHealthState); Queue | join kind=inner OnlineDevices on MdatpDeviceId | project ItemId, MdatpDeviceId, DeviceName = coalesce(DeviceName, DefenderDeviceName), IncidentId, TagName, EnqueuedTime, Attempts, Status, LastSeen, SensorHealthState",
                  "timerange": "Set in query"
                }
              }
            },
            "Run_Duplicate_Queue_Query": {
              "type": "ApiConnection",
              "runAfter": {
                "Run_Online_Queue_Query": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuremonitorlogs']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/queryData",
                "queries": {
                  "subscriptions": "@parameters('WorkspaceSubscriptionId')",
                  "resourcegroups": "@parameters('WorkspaceResourceGroup')",
                  "resourcetype": "Log Analytics Workspace",
                  "resourcename": "@parameters('WorkspaceName')",
                  "query": "let Queue = Watchlist | where WatchlistAlias == '@{parameters('WatchlistAlias')}' | where _DTItemType == 'watchlist-item' | summarize arg_max(TimeGenerated, *) by _DTItemId | where _DTItemStatus != 'Delete' | extend item = parse_json(WatchlistItem) | project ItemId = tostring(_DTItemId), MdatpDeviceId = tostring(item.MdatpDeviceId), DeviceName = tostring(item.DeviceName), EnqueuedTime = todatetime(item.EnqueuedTime) | where isnotempty(MdatpDeviceId); let Latest = Queue | summarize MaxEnq = max(EnqueuedTime) by MdatpDeviceId; Queue | join kind=inner Latest on MdatpDeviceId | where EnqueuedTime < MaxEnq | project ItemId, MdatpDeviceId, DeviceName, EnqueuedTime",
                  "timerange": "Set in query"
                }
              }
            },
            "Select_Duplicate_Item_Ids": {
              "type": "Select",
              "runAfter": {
                "Run_Duplicate_Queue_Query": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@coalesce(body('Run_Duplicate_Queue_Query')?['value'], body('Run_Duplicate_Queue_Query'), json('[]'))",
                "select": {
                  "ItemId": "@{item()?['ItemId']}"
                }
              }
            },
            "For_Each_Duplicate_Item": {
              "type": "Foreach",
              "runAfter": {
                "Select_Duplicate_Item_Ids": [
                  "Succeeded"
                ]
              },
              "foreach": "@body('Select_Duplicate_Item_Ids')",
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 5
                }
              },
              "actions": {
                "Delete_Duplicate_Watchlist_Item": {
                  "type": "ApiConnection",
                  "runAfter": {},
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                      }
                    },
                    "method": "delete",
                    "path": "/Watchlists/subscriptions/@{encodeURIComponent(parameters('WorkspaceSubscriptionId'))}/resourceGroups/@{encodeURIComponent(parameters('WorkspaceResourceGroup'))}/workspaces/@{encodeURIComponent(parameters('WorkspaceCustomerId'))}/watchlists/@{encodeURIComponent(parameters('WatchlistAlias'))}/watchlistItem/@{encodeURIComponent(items('For_Each_Duplicate_Item')?['ItemId'])}"
                  }
                }
              }
            },
            "Select_Online_Device_Rows": {
              "type": "Select",
              "runAfter": {
                "Run_Online_Queue_Query": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@coalesce(body('Run_Online_Queue_Query')?['value'], body('Run_Online_Queue_Query'), json('[]'))",
                "select": {
                  "ItemId": "@{item()?['ItemId']}",
                  "MdatpDeviceId": "@{item()?['MdatpDeviceId']}",
                  "DeviceName": "@{item()?['DeviceName']}",
                  "IncidentId": "@{item()?['IncidentId']}",
                  "TagName": "@{item()?['TagName']}",
                  "EnqueuedTime": "@{item()?['EnqueuedTime']}",
                  "Attempts": "@{item()?['Attempts']}"
                }
              }
            },
            "For_Each_Online_Device": {
              "type": "Foreach",
              "runAfter": {
                "Select_Online_Device_Rows": [
                  "Succeeded"
                ]
              },
              "foreach": "@body('Select_Online_Device_Rows')",
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 5
                }
              },
              "actions": {
                "Trigger_Collection": {
                  "type": "Http",
                  "runAfter": {},
                  "inputs": {
                    "method": "POST",
                    "uri": "@parameters('CollectionTriggerUrl')",
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "body": {
                      "IncidentId": "@{items('For_Each_Online_Device')?['IncidentId']}",
                      "TagName": "@{items('For_Each_Online_Device')?['TagName']}",
                      "WatchlistItemId": "@{items('For_Each_Online_Device')?['ItemId']}",
                      "MdatpDeviceId": "@{items('For_Each_Online_Device')?['MdatpDeviceId']}",
                      "DeviceName": "@{items('For_Each_Online_Device')?['DeviceName']}",
                      "EnqueuedTime": "@{items('For_Each_Online_Device')?['EnqueuedTime']}",
                      "Attempts": "@{items('For_Each_Online_Device')?['Attempts']}"
                    }
                  }
                }
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "azuremonitorlogs": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('azureMonitorLogsConnectionName'))]",
                "connectionName": "[variables('azureMonitorLogsConnectionName')]",
                "id": "[variables('azureMonitorLogsConnectionId')]",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                }
              },
              "azuresentinel": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('sentinelConnectionName'))]",
                "connectionName": "[variables('sentinelConnectionName')]",
                "id": "[variables('sentinelConnectionId')]",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                }
              }
            }
          },
          "CollectionTriggerUrl": {
            "value": "[listCallbackURL(resourceId('Microsoft.Logic/workflows/triggers', variables('CollectionPlaybookName'), 'manual'), '2019-05-01').value]"
          }
        }
      }
    }
  ],
  "outputs": {
    "playbookName": {
      "type": "string",
      "value": "[variables('PlaybookName')]"
    },
    "logicAppName": {
      "type": "string",
      "value": "[variables('PlaybookName')]"
    },
    "logicAppResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Logic/workflows', variables('PlaybookName'))]"
    },
    "principalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', variables('PlaybookName')), '2019-05-01', 'full').identity.principalId]"
    },
    "watchlistResourceId": {
      "type": "string",
      "value": "[variables('watchlistResourceId')]"
    },
    "requiredRoleAssignments": {
      "type": "array",
      "value": [
        "Log Analytics Reader on the Sentinel workspace",
        "Microsoft Sentinel Contributor on the Sentinel workspace (to delete watchlist items)"
      ]
    }
  }
}
