{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.1.0.0",
  "metadata": {
    "title": "Check-CyberTriageQueue",
    "description": "Polls the ForensicCollectQueue Sentinel watchlist on a schedule using ARM Watchlist REST API and managed identity. Fires the CyberTriage-LiveResponse-Collection playbook for each queued device without requiring Log Analytics DeviceInfo tables.",
    "author": "Security Engineering"
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "SentinelWorkspaceResourceGroup": {
      "type": "string"
    },
    "SentinelWorkspaceName": {
      "type": "string"
    },
    "SentinelWorkspaceCustomerId": {
      "type": "string"
    },
    "SentinelWorkspaceSubscriptionId": {
      "type": "string",
      "defaultValue": "[subscription().subscriptionId]"
    },
    "WatchlistAlias": {
      "type": "string",
      "defaultValue": "ForensicCollectQueue"
    },
    "PollFrequencyMinutes": {
      "type": "int",
      "defaultValue": 60
    },
    "OnlineWindowMinutes": {
      "type": "int",
      "defaultValue": 60
    },
    "ArmBaseUri": {
      "type": "string",
      "defaultValue": "https://management.azure.com",
      "metadata": {
        "description": "Azure Resource Manager base URI used by the watchlist REST call."
      }
    },
    "ArmAudience": {
      "type": "string",
      "defaultValue": "https://management.azure.com/",
      "metadata": {
        "description": "Managed identity token audience/resource for Azure Resource Manager calls."
      }
    }
  },
  "variables": {
    "PlaybookName": "Check-CyberTriageQueue",
    "CollectionPlaybookName": "CyberTriage-LiveResponse-Collection",
    "watchlistResourceId": "[concat('/subscriptions/', parameters('SentinelWorkspaceSubscriptionId'), '/resourceGroups/', parameters('SentinelWorkspaceResourceGroup'), '/providers/Microsoft.OperationalInsights/workspaces/', parameters('SentinelWorkspaceName'), '/providers/Microsoft.SecurityInsights/watchlists/', parameters('WatchlistAlias'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[variables('PlaybookName')]",
      "location": "[parameters('location')]",
      "tags": {
        "purpose": "security-playbook",
        "tool": "cybertriage",
        "component": "queue-poller",
        "trigger-model": "recurrence"
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "state": "Disabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.1.0.0",
          "parameters": {
            "WorkspaceSubscriptionId": {
              "type": "String",
              "defaultValue": "[parameters('SentinelWorkspaceSubscriptionId')]"
            },
            "WorkspaceResourceGroup": {
              "type": "String",
              "defaultValue": "[parameters('SentinelWorkspaceResourceGroup')]"
            },
            "WorkspaceName": {
              "type": "String",
              "defaultValue": "[parameters('SentinelWorkspaceName')]"
            },
            "WorkspaceCustomerId": {
              "type": "String",
              "defaultValue": "[parameters('SentinelWorkspaceCustomerId')]"
            },
            "WatchlistAlias": {
              "type": "String",
              "defaultValue": "[parameters('WatchlistAlias')]"
            },
            "OnlineWindowMinutes": {
              "type": "Int",
              "defaultValue": "[parameters('OnlineWindowMinutes')]"
            },
            "ArmBaseUri": {
              "type": "String",
              "defaultValue": "[parameters('ArmBaseUri')]"
            },
            "ArmAudience": {
              "type": "String",
              "defaultValue": "[parameters('ArmAudience')]"
            },
            "CollectionTriggerUrl": {
              "type": "SecureString"
            }
          },
          "triggers": {
            "Recurrence": {
              "type": "Recurrence",
              "recurrence": {
                "frequency": "Minute",
                "interval": "[parameters('PollFrequencyMinutes')]"
              }
            }
          },
          "actions": {
            "Run_Online_Queue_Query": {
              "type": "Http",
              "runAfter": {},
              "inputs": {
                "method": "GET",
                "uri": "@{concat(parameters('ArmBaseUri'), '/subscriptions/', parameters('WorkspaceSubscriptionId'), '/resourceGroups/', parameters('WorkspaceResourceGroup'), '/providers/Microsoft.OperationalInsights/workspaces/', parameters('WorkspaceName'), '/providers/Microsoft.SecurityInsights/watchlists/', parameters('WatchlistAlias'), '/watchlistItems?api-version=2023-09-01-preview')}",
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "@parameters('ArmAudience')"
                }
              }
            },
            "Select_Online_Device_Rows": {
              "type": "Select",
              "runAfter": {
                "Run_Online_Queue_Query": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@coalesce(body('Run_Online_Queue_Query')?['value'], json('[]'))",
                "select": {
                  "ItemId": "@{item()?['name']}",
                  "MdatpDeviceId": "@{item()?['properties']?['itemsKeyValue']?['MdatpDeviceId']}",
                  "DeviceName": "@{item()?['properties']?['itemsKeyValue']?['DeviceName']}",
                  "IncidentId": "@{item()?['properties']?['itemsKeyValue']?['IncidentId']}",
                  "TagName": "@{item()?['properties']?['itemsKeyValue']?['TagName']}",
                  "EnqueuedTime": "@{item()?['properties']?['itemsKeyValue']?['EnqueuedTime']}",
                  "Attempts": "@{item()?['properties']?['itemsKeyValue']?['Attempts']}",
                  "Status": "@{item()?['properties']?['itemsKeyValue']?['Status']}",
                  "RetryAfterUtc": "@{item()?['properties']?['itemsKeyValue']?['RetryAfterUtc']}"
                }
              }
            },
            "For_Each_Online_Device": {
              "type": "Foreach",
              "runAfter": {
                "Select_Online_Device_Rows": [
                  "Succeeded"
                ]
              },
              "foreach": "@body('Select_Online_Device_Rows')",
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 5
                }
              },
              "actions": {
                "Trigger_Collection": {
                  "type": "Http",
                  "runAfter": {},
                  "inputs": {
                    "method": "POST",
                    "uri": "@parameters('CollectionTriggerUrl')",
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "body": {
                      "IncidentId": "@{items('For_Each_Online_Device')?['IncidentId']}",
                      "TagName": "@{items('For_Each_Online_Device')?['TagName']}",
                      "WatchlistItemId": "@{items('For_Each_Online_Device')?['ItemId']}",
                      "MdatpDeviceId": "@{items('For_Each_Online_Device')?['MdatpDeviceId']}",
                      "DeviceName": "@{items('For_Each_Online_Device')?['DeviceName']}",
                      "EnqueuedTime": "@{items('For_Each_Online_Device')?['EnqueuedTime']}",
                      "Attempts": "@{items('For_Each_Online_Device')?['Attempts']}"
                    }
                  }
                }
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "CollectionTriggerUrl": {
            "value": "[listCallbackURL(resourceId('Microsoft.Logic/workflows/triggers', variables('CollectionPlaybookName'), 'manual'), '2019-05-01').value]"
          }
        }
      }
    }
  ],
  "outputs": {
    "playbookName": {
      "type": "string",
      "value": "[variables('PlaybookName')]"
    },
    "logicAppName": {
      "type": "string",
      "value": "[variables('PlaybookName')]"
    },
    "logicAppResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Logic/workflows', variables('PlaybookName'))]"
    },
    "principalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', variables('PlaybookName')), '2019-05-01', 'full').identity.principalId]"
    },
    "watchlistResourceId": {
      "type": "string",
      "value": "[variables('watchlistResourceId')]"
    },
    "requiredRoleAssignments": {
      "type": "array",
      "value": [
        "Microsoft Sentinel Reader or Contributor on the Sentinel workspace for watchlist item reads"
      ]
    }
  }
}
