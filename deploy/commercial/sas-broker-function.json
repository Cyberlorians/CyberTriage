{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "title": "CyberTriage SAS Broker Function",
    "description": "Deploys the SAS broker Function App, managed identity, Function host storage account, and GitHub source control deployment for src/SasBrokerNode.",
    "author": "Security Engineering"
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "SasBrokerFunctionAppName": {
      "type": "string",
      "defaultValue": "[concat('func-ct-sas-', uniqueString(resourceGroup().id))]",
      "metadata": {
        "description": "Name of the SAS broker Function App. This becomes https://<name>.azurewebsites.net."
      }
    },
    "FunctionHostStorageAccountName": {
      "type": "string",
      "defaultValue": "[toLower(concat('stctsas', uniqueString(resourceGroup().id)))]",
      "metadata": {
        "description": "Storage account used by the Function host runtime. Must be globally unique, lowercase, and 3-24 characters."
      }
    },
    "BrokerSharedSecret": {
      "type": "securestring",
      "metadata": {
        "description": "Long random secret used by the collection Logic App to call the broker. This is not a storage key."
      }
    },
    "RepositoryUrl": {
      "type": "string",
      "defaultValue": "https://github.com/Cyberlorians/CyberTriage",
      "metadata": {
        "description": "Repository that contains the Function source. The .deployment file points Azure to src/SasBrokerNode."
      }
    },
    "RepositoryBranch": {
      "type": "string",
      "defaultValue": "main"
    }
  },
  "variables": {
    "hostingPlanName": "[concat('asp-', parameters('SasBrokerFunctionAppName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[parameters('FunctionHostStorageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "allowBlobPublicAccess": false,
        "allowSharedKeyAccess": false,
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true,
        "publicNetworkAccess": "Enabled",
        "networkAcls": {
          "bypass": "AzureServices",
          "defaultAction": "Allow"
        }
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2022-09-01",
      "name": "[variables('hostingPlanName')]",
      "location": "[parameters('location')]",
      "kind": "functionapp",
      "sku": {
        "name": "Y1",
        "tier": "Dynamic"
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2022-09-01",
      "name": "[parameters('SasBrokerFunctionAppName')]",
      "location": "[parameters('location')]",
      "kind": "functionapp,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('FunctionHostStorageAccountName'))]",
        "[resourceId('Microsoft.Web/serverfarms', variables('hostingPlanName'))]"
      ],
      "properties": {
        "httpsOnly": true,
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('hostingPlanName'))]",
        "siteConfig": {
          "linuxFxVersion": "Node|20",
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "appSettings": [
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "node"
            },
            {
              "name": "AzureWebJobsStorage__accountName",
              "value": "[parameters('FunctionHostStorageAccountName')]"
            },
            {
              "name": "AzureWebJobsStorage__credential",
              "value": "managedidentity"
            },
            {
              "name": "BROKER_SHARED_SECRET",
              "value": "[parameters('BrokerSharedSecret')]"
            },
            {
              "name": "SCM_DO_BUILD_DURING_DEPLOYMENT",
              "value": "true"
            },
            {
              "name": "ENABLE_ORYX_BUILD",
              "value": "true"
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Web/sites/sourcecontrols",
      "apiVersion": "2022-09-01",
      "name": "[concat(parameters('SasBrokerFunctionAppName'), '/web')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('SasBrokerFunctionAppName'))]"
      ],
      "properties": {
        "repoUrl": "[parameters('RepositoryUrl')]",
        "branch": "[parameters('RepositoryBranch')]",
        "isManualIntegration": true,
        "deploymentRollbackEnabled": false
      }
    }
  ],
  "outputs": {
    "functionAppName": {
      "type": "string",
      "value": "[parameters('SasBrokerFunctionAppName')]"
    },
    "functionAppResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Web/sites', parameters('SasBrokerFunctionAppName'))]"
    },
    "functionPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', parameters('SasBrokerFunctionAppName')), '2022-09-01', 'full').identity.principalId]"
    },
    "functionHostStorageAccountName": {
      "type": "string",
      "value": "[parameters('FunctionHostStorageAccountName')]"
    },
    "healthUrl": {
      "type": "string",
      "value": "[concat('https://', parameters('SasBrokerFunctionAppName'), '.azurewebsites.net/api/health')]"
    },
    "brokerUrlFormat": {
      "type": "string",
      "value": "[concat('https://', parameters('SasBrokerFunctionAppName'), '.azurewebsites.net/api/generate-cybertriagesas?brokerCode=<BrokerSharedSecret>')]"
    }
  }
}
