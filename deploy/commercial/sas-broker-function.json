{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "title": "CyberTriage SAS Broker Function",
    "description": "Deploys the SAS broker Function App, managed identity, Function host storage account, host storage RBAC, and GitHub source control deployment for src/SasBrokerNode.",
    "author": "Security Engineering"
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "SasBrokerFunctionAppName": {
      "type": "string",
      "defaultValue": "[concat('func-ct-sas-', uniqueString(resourceGroup().id))]",
      "metadata": {
        "description": "Name of the SAS broker Function App. Azure returns the actual default hostname after deployment."
      }
    },
    "FunctionHostStorageAccountName": {
      "type": "string",
      "defaultValue": "[toLower(concat('stctsas', uniqueString(resourceGroup().id)))]",
      "metadata": {
        "description": "Storage account used by the Function host runtime. Must be globally unique, lowercase, and 3-24 characters."
      }
    },
    "BrokerSharedSecret": {
      "type": "securestring",
      "metadata": {
        "description": "Long random secret used by the collection Logic App to call the broker. This is not a storage key."
      }
    },
    "RepositoryUrl": {
      "type": "string",
      "defaultValue": "https://github.com/Cyberlorians/CyberTriage",
      "metadata": {
        "description": "Repository that contains the Function source. The .deployment file points Azure to src/SasBrokerNode."
      }
    },
    "RepositoryBranch": {
      "type": "string",
      "defaultValue": "main"
    },
    "StorageBlobDnsSuffix": {
      "type": "string",
      "defaultValue": "blob.core.windows.net",
      "metadata": {
        "description": "Blob service DNS suffix used by generated SAS URLs. Commercial: blob.core.windows.net. Azure Government: blob.core.usgovcloudapi.net."
      }
    },
    "StorageTokenResource": {
      "type": "string",
      "defaultValue": "https://storage.azure.com/",
      "metadata": {
        "description": "Managed identity token resource used when requesting Azure Storage user delegation keys."
      }
    }
  },
  "variables": {
    "hostingPlanName": "[concat('asp-', parameters('SasBrokerFunctionAppName'))]",
    "storageBlobDataContributorRoleId": "ba92f5b4-2d11-453d-a403-e96b0029c9fe",
    "storageQueueDataContributorRoleId": "974c5e8b-45b9-4653-ba55-5f855dd0fb88",
    "storageTableDataContributorRoleId": "0a9a7e1f-b9d0-4cc4-a60d-0319b160aaa3"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[parameters('FunctionHostStorageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "allowBlobPublicAccess": false,
        "allowSharedKeyAccess": false,
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true,
        "publicNetworkAccess": "Enabled",
        "networkAcls": {
          "bypass": "AzureServices",
          "defaultAction": "Allow"
        }
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2022-09-01",
      "name": "[variables('hostingPlanName')]",
      "location": "[parameters('location')]",
      "kind": "functionapp",
      "sku": {
        "name": "Y1",
        "tier": "Dynamic"
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2022-09-01",
      "name": "[parameters('SasBrokerFunctionAppName')]",
      "location": "[parameters('location')]",
      "kind": "functionapp,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('FunctionHostStorageAccountName'))]",
        "[resourceId('Microsoft.Web/serverfarms', variables('hostingPlanName'))]"
      ],
      "properties": {
        "httpsOnly": true,
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('hostingPlanName'))]",
        "siteConfig": {
          "linuxFxVersion": "Node|20",
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "appSettings": [
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "node"
            },
            {
              "name": "AzureWebJobsStorage__accountName",
              "value": "[parameters('FunctionHostStorageAccountName')]"
            },
            {
              "name": "AzureWebJobsStorage__credential",
              "value": "managedidentity"
            },
            {
              "name": "BROKER_SHARED_SECRET",
              "value": "[parameters('BrokerSharedSecret')]"
            },
            {
              "name": "STORAGE_BLOB_DNS_SUFFIX",
              "value": "[parameters('StorageBlobDnsSuffix')]"
            },
            {
              "name": "STORAGE_TOKEN_RESOURCE",
              "value": "[parameters('StorageTokenResource')]"
            },
            {
              "name": "SCM_DO_BUILD_DURING_DEPLOYMENT",
              "value": "true"
            },
            {
              "name": "ENABLE_ORYX_BUILD",
              "value": "true"
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Web/sites/sourcecontrols",
      "apiVersion": "2022-09-01",
      "name": "[concat(parameters('SasBrokerFunctionAppName'), '/web')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('SasBrokerFunctionAppName'))]",
        "[extensionResourceId(resourceId('Microsoft.Storage/storageAccounts', parameters('FunctionHostStorageAccountName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.Storage/storageAccounts', parameters('FunctionHostStorageAccountName')), parameters('SasBrokerFunctionAppName'), variables('storageBlobDataContributorRoleId')))]",
        "[extensionResourceId(resourceId('Microsoft.Storage/storageAccounts', parameters('FunctionHostStorageAccountName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.Storage/storageAccounts', parameters('FunctionHostStorageAccountName')), parameters('SasBrokerFunctionAppName'), variables('storageQueueDataContributorRoleId')))]",
        "[extensionResourceId(resourceId('Microsoft.Storage/storageAccounts', parameters('FunctionHostStorageAccountName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.Storage/storageAccounts', parameters('FunctionHostStorageAccountName')), parameters('SasBrokerFunctionAppName'), variables('storageTableDataContributorRoleId')))]"
      ],
      "properties": {
        "repoUrl": "[parameters('RepositoryUrl')]",
        "branch": "[parameters('RepositoryBranch')]",
        "isManualIntegration": true,
        "deploymentRollbackEnabled": false
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', parameters('FunctionHostStorageAccountName')), parameters('SasBrokerFunctionAppName'), variables('storageBlobDataContributorRoleId'))]",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', parameters('FunctionHostStorageAccountName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('FunctionHostStorageAccountName'))]",
        "[resourceId('Microsoft.Web/sites', parameters('SasBrokerFunctionAppName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('storageBlobDataContributorRoleId'))]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', parameters('SasBrokerFunctionAppName')), '2022-09-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', parameters('FunctionHostStorageAccountName')), parameters('SasBrokerFunctionAppName'), variables('storageQueueDataContributorRoleId'))]",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', parameters('FunctionHostStorageAccountName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('FunctionHostStorageAccountName'))]",
        "[resourceId('Microsoft.Web/sites', parameters('SasBrokerFunctionAppName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('storageQueueDataContributorRoleId'))]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', parameters('SasBrokerFunctionAppName')), '2022-09-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', parameters('FunctionHostStorageAccountName')), parameters('SasBrokerFunctionAppName'), variables('storageTableDataContributorRoleId'))]",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', parameters('FunctionHostStorageAccountName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('FunctionHostStorageAccountName'))]",
        "[resourceId('Microsoft.Web/sites', parameters('SasBrokerFunctionAppName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('storageTableDataContributorRoleId'))]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', parameters('SasBrokerFunctionAppName')), '2022-09-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    }
  ],
  "outputs": {
    "functionAppName": {
      "type": "string",
      "value": "[parameters('SasBrokerFunctionAppName')]"
    },
    "functionAppResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Web/sites', parameters('SasBrokerFunctionAppName'))]"
    },
    "functionPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', parameters('SasBrokerFunctionAppName')), '2022-09-01', 'full').identity.principalId]"
    },
    "functionHostStorageAccountName": {
      "type": "string",
      "value": "[parameters('FunctionHostStorageAccountName')]"
    },
    "functionDefaultHostName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', parameters('SasBrokerFunctionAppName')), '2022-09-01').defaultHostName]"
    },
    "healthUrl": {
      "type": "string",
      "value": "[concat('https://', reference(resourceId('Microsoft.Web/sites', parameters('SasBrokerFunctionAppName')), '2022-09-01').defaultHostName, '/api/health')]"
    },
    "brokerUrlFormat": {
      "type": "string",
      "value": "[concat('https://', reference(resourceId('Microsoft.Web/sites', parameters('SasBrokerFunctionAppName')), '2022-09-01').defaultHostName, '/api/generate-cybertriagesas?brokerCode=<BrokerSharedSecret>')]"
    }
  }
}
