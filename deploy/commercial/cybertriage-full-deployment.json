{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "title": "CyberTriage Full Commercial Deployment",
    "description": "Deploys the evidence storage account, SAS broker Function App, all three CyberTriage Logic Apps, and Azure RBAC role assignments into one resource group. Connector authorization is still completed after deployment.",
    "author": "Security Engineering"
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "SasBrokerFunctionAppName": {
      "type": "string",
      "defaultValue": "[concat('func-ct-sas-', uniqueString(resourceGroup().id))]",
      "metadata": {
        "description": "Name of the SAS broker Function App."
      }
    },
    "FunctionHostStorageAccountName": {
      "type": "string",
      "defaultValue": "[toLower(concat('stctsas', uniqueString(resourceGroup().id)))]",
      "metadata": {
        "description": "Storage account used by the SAS broker Function host runtime."
      }
    },
    "BrokerSharedSecret": {
      "type": "securestring",
      "metadata": {
        "description": "Long random secret for the SAS broker. Save it securely. It is not a storage account key."
      }
    },
    "DestinationStorageAccountName": {
      "type": "string",
      "defaultValue": "[toLower(concat('stctresults', uniqueString(resourceGroup().id)))]",
      "metadata": {
        "description": "Evidence storage account created by this deployment for encrypted CyberTriage artifacts. Must be globally unique, lowercase, and 3-24 characters."
      }
    },
    "TargetDeviceTag": {
      "type": "string",
      "defaultValue": "ForensicCollect"
    },
    "NotificationEmail": {
      "type": "string",
      "metadata": {
        "description": "Email address for optional Office 365 notification."
      }
    },
    "SentinelWorkspaceResourceGroup": {
      "type": "string",
      "defaultValue": "Sentinel"
    },
    "SentinelWorkspaceName": {
      "type": "string",
      "defaultValue": "<sentinel-workspace-name>"
    },
    "SentinelWorkspaceCustomerId": {
      "type": "string",
      "defaultValue": "<workspace-guid>"
    },
    "SentinelWorkspaceSubscriptionId": {
      "type": "string",
      "defaultValue": "[subscription().subscriptionId]"
    },
    "WatchlistAlias": {
      "type": "string",
      "defaultValue": "ForensicCollectQueue"
    },
    "SasExpiryMinutes": {
      "type": "int",
      "defaultValue": 1440
    },
    "SasPermissions": {
      "type": "string",
      "defaultValue": "racwdl"
    },
    "PollFrequencyMinutes": {
      "type": "int",
      "defaultValue": 60
    },
    "OnlineWindowMinutes": {
      "type": "int",
      "defaultValue": 60
    },
    "TemplateBaseUri": {
      "type": "string",
      "defaultValue": "https://raw.githubusercontent.com/Cyberlorians/CyberTriage/main/deploy/commercial/",
      "metadata": {
        "description": "Base URI for linked commercial templates."
      }
    }
  },
  "variables": {
    "collectionPlaybookName": "CyberTriage-LiveResponse-Collection",
    "setPlaybookName": "Set-CyberTriage",
    "queuePlaybookName": "Check-CyberTriageQueue",
    "destinationContainerName": "cybertriage-results",
    "sasBrokerUrl": "[concat('https://', parameters('SasBrokerFunctionAppName'), '.azurewebsites.net/api/generate-cybertriagesas?brokerCode=', parameters('BrokerSharedSecret'))]",
    "evidenceStorageResourceId": "[resourceId('Microsoft.Storage/storageAccounts', parameters('DestinationStorageAccountName'))]",
    "functionHostStorageResourceId": "[resourceId('Microsoft.Storage/storageAccounts', parameters('FunctionHostStorageAccountName'))]",
    "storageBlobDelegatorRoleId": "db58b8e5-c6ad-4a2a-8342-4190687cbf4a",
    "storageBlobDataContributorRoleId": "ba92f5b4-2d11-453d-a403-e96b0029c9fe",
    "logAnalyticsReaderRoleId": "73c42c96-874c-492b-b04d-ab87d138a893",
    "sentinelContributorRoleId": "ab8e14d6-4a74-4a29-9ba8-549422addade"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[parameters('DestinationStorageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "allowBlobPublicAccess": false,
        "allowSharedKeyAccess": false,
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true,
        "publicNetworkAccess": "Enabled",
        "networkAcls": {
          "bypass": "AzureServices",
          "defaultAction": "Allow"
        }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}/default/{1}', parameters('DestinationStorageAccountName'), variables('destinationContainerName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('DestinationStorageAccountName'))]"
      ],
      "properties": {
        "publicAccess": "None"
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "Deploy-SasBrokerFunction",
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[concat(parameters('TemplateBaseUri'), 'sas-broker-function.json')]",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "SasBrokerFunctionAppName": {
            "value": "[parameters('SasBrokerFunctionAppName')]"
          },
          "FunctionHostStorageAccountName": {
            "value": "[parameters('FunctionHostStorageAccountName')]"
          },
          "BrokerSharedSecret": {
            "value": "[parameters('BrokerSharedSecret')]"
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "Deploy-CyberTriage-LiveResponse-Collection",
      "dependsOn": [
        "Deploy-SasBrokerFunction",
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', parameters('DestinationStorageAccountName'), 'default', variables('destinationContainerName'))]"
      ],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[concat(parameters('TemplateBaseUri'), 'cybertriage-live-response-collection.json')]",
          "contentVersion": "3.1.0.0"
        },
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "TargetDeviceTag": {
            "value": "[parameters('TargetDeviceTag')]"
          },
          "DestinationStorageAccountName": {
            "value": "[parameters('DestinationStorageAccountName')]"
          },
          "SasBrokerUrl": {
            "value": "[variables('sasBrokerUrl')]"
          },
          "SasExpiryMinutes": {
            "value": "[parameters('SasExpiryMinutes')]"
          },
          "SasPermissions": {
            "value": "[parameters('SasPermissions')]"
          },
          "NotificationEmail": {
            "value": "[parameters('NotificationEmail')]"
          },
          "SentinelWorkspaceResourceGroup": {
            "value": "[parameters('SentinelWorkspaceResourceGroup')]"
          },
          "SentinelWorkspaceName": {
            "value": "[parameters('SentinelWorkspaceName')]"
          },
          "SentinelWorkspaceCustomerId": {
            "value": "[parameters('SentinelWorkspaceCustomerId')]"
          },
          "SentinelWorkspaceSubscriptionId": {
            "value": "[parameters('SentinelWorkspaceSubscriptionId')]"
          },
          "WatchlistAlias": {
            "value": "[parameters('WatchlistAlias')]"
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "Deploy-Set-CyberTriage",
      "dependsOn": [
        "Deploy-CyberTriage-LiveResponse-Collection"
      ],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[concat(parameters('TemplateBaseUri'), 'set-cybertriage.json')]",
          "contentVersion": "3.0.0.0"
        },
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "TargetDeviceTag": {
            "value": "[parameters('TargetDeviceTag')]"
          },
          "SentinelWorkspaceResourceGroup": {
            "value": "[parameters('SentinelWorkspaceResourceGroup')]"
          },
          "SentinelWorkspaceName": {
            "value": "[parameters('SentinelWorkspaceName')]"
          },
          "SentinelWorkspaceCustomerId": {
            "value": "[parameters('SentinelWorkspaceCustomerId')]"
          },
          "SentinelWorkspaceSubscriptionId": {
            "value": "[parameters('SentinelWorkspaceSubscriptionId')]"
          },
          "WatchlistAlias": {
            "value": "[parameters('WatchlistAlias')]"
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "Deploy-Check-CyberTriageQueue",
      "dependsOn": [
        "Deploy-CyberTriage-LiveResponse-Collection"
      ],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[concat(parameters('TemplateBaseUri'), 'check-cybertriage-queue.json')]",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "SentinelWorkspaceResourceGroup": {
            "value": "[parameters('SentinelWorkspaceResourceGroup')]"
          },
          "SentinelWorkspaceName": {
            "value": "[parameters('SentinelWorkspaceName')]"
          },
          "SentinelWorkspaceCustomerId": {
            "value": "[parameters('SentinelWorkspaceCustomerId')]"
          },
          "SentinelWorkspaceSubscriptionId": {
            "value": "[parameters('SentinelWorkspaceSubscriptionId')]"
          },
          "WatchlistAlias": {
            "value": "[parameters('WatchlistAlias')]"
          },
          "PollFrequencyMinutes": {
            "value": "[parameters('PollFrequencyMinutes')]"
          },
          "OnlineWindowMinutes": {
            "value": "[parameters('OnlineWindowMinutes')]"
          }
        }
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(variables('evidenceStorageResourceId'), parameters('SasBrokerFunctionAppName'), variables('storageBlobDelegatorRoleId'))]",
      "scope": "[variables('evidenceStorageResourceId')]",
      "dependsOn": [
        "Deploy-SasBrokerFunction",
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('DestinationStorageAccountName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('storageBlobDelegatorRoleId'))]",
        "principalId": "[reference('Deploy-SasBrokerFunction').outputs.functionPrincipalId.value]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(variables('evidenceStorageResourceId'), parameters('SasBrokerFunctionAppName'), variables('storageBlobDataContributorRoleId'))]",
      "scope": "[variables('evidenceStorageResourceId')]",
      "dependsOn": [
        "Deploy-SasBrokerFunction",
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('DestinationStorageAccountName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('storageBlobDataContributorRoleId'))]",
        "principalId": "[reference('Deploy-SasBrokerFunction').outputs.functionPrincipalId.value]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "Deploy-Sentinel-Rbac",
      "subscriptionId": "[parameters('SentinelWorkspaceSubscriptionId')]",
      "resourceGroup": "[parameters('SentinelWorkspaceResourceGroup')]",
      "dependsOn": [
        "Deploy-CyberTriage-LiveResponse-Collection",
        "Deploy-Set-CyberTriage",
        "Deploy-Check-CyberTriageQueue"
      ],
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "parameters": {
          "SentinelWorkspaceName": {
            "value": "[parameters('SentinelWorkspaceName')]"
          },
          "CollectionPrincipalId": {
            "value": "[reference(resourceId('Microsoft.Logic/workflows', variables('collectionPlaybookName')), '2019-05-01', 'full').identity.principalId]"
          },
          "SetPrincipalId": {
            "value": "[reference(resourceId('Microsoft.Logic/workflows', variables('setPlaybookName')), '2019-05-01', 'full').identity.principalId]"
          },
          "QueuePrincipalId": {
            "value": "[reference(resourceId('Microsoft.Logic/workflows', variables('queuePlaybookName')), '2019-05-01', 'full').identity.principalId]"
          },
          "SentinelContributorRoleId": {
            "value": "[variables('sentinelContributorRoleId')]"
          },
          "LogAnalyticsReaderRoleId": {
            "value": "[variables('logAnalyticsReaderRoleId')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "SentinelWorkspaceName": {
              "type": "string"
            },
            "CollectionPrincipalId": {
              "type": "string"
            },
            "SetPrincipalId": {
              "type": "string"
            },
            "QueuePrincipalId": {
              "type": "string"
            },
            "SentinelContributorRoleId": {
              "type": "string"
            },
            "LogAnalyticsReaderRoleId": {
              "type": "string"
            }
          },
          "variables": {
            "sentinelWorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('SentinelWorkspaceName'))]"
          },
          "resources": [
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(variables('sentinelWorkspaceResourceId'), parameters('CollectionPrincipalId'), parameters('SentinelContributorRoleId'))]",
              "scope": "[variables('sentinelWorkspaceResourceId')]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', parameters('SentinelContributorRoleId'))]",
                "principalId": "[parameters('CollectionPrincipalId')]",
                "principalType": "ServicePrincipal"
              }
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(variables('sentinelWorkspaceResourceId'), parameters('SetPrincipalId'), parameters('SentinelContributorRoleId'))]",
              "scope": "[variables('sentinelWorkspaceResourceId')]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', parameters('SentinelContributorRoleId'))]",
                "principalId": "[parameters('SetPrincipalId')]",
                "principalType": "ServicePrincipal"
              }
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(variables('sentinelWorkspaceResourceId'), parameters('QueuePrincipalId'), parameters('LogAnalyticsReaderRoleId'))]",
              "scope": "[variables('sentinelWorkspaceResourceId')]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', parameters('LogAnalyticsReaderRoleId'))]",
                "principalId": "[parameters('QueuePrincipalId')]",
                "principalType": "ServicePrincipal"
              }
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(variables('sentinelWorkspaceResourceId'), parameters('QueuePrincipalId'), parameters('SentinelContributorRoleId'))]",
              "scope": "[variables('sentinelWorkspaceResourceId')]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', parameters('SentinelContributorRoleId'))]",
                "principalId": "[parameters('QueuePrincipalId')]",
                "principalType": "ServicePrincipal"
              }
            }
          ]
        }
      }
    }
  ],
  "outputs": {
    "sasBrokerFunctionAppName": {
      "type": "string",
      "value": "[parameters('SasBrokerFunctionAppName')]"
    },
    "functionHostStorageAccountName": {
      "type": "string",
      "value": "[parameters('FunctionHostStorageAccountName')]"
    },
    "collectionLogicAppName": {
      "type": "string",
      "value": "[variables('collectionPlaybookName')]"
    },
    "setLogicAppName": {
      "type": "string",
      "value": "[variables('setPlaybookName')]"
    },
    "queueLogicAppName": {
      "type": "string",
      "value": "[variables('queuePlaybookName')]"
    },
    "watchlistAlias": {
      "type": "string",
      "value": "[parameters('WatchlistAlias')]"
    },
    "nextStep": {
      "type": "string",
      "value": "Grant Defender for Endpoint app roles if the full ARM deployer could not run the admin script, authorize any non-MDE API connections that still require sign-in, create the ForensicCollectQueue watchlist, upload MDE Live Response library files, and run one test. See docs/setting-permissions-step-by-step.md."
    }
  }
}
