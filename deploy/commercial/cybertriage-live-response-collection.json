{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "3.1.0.0",
  "metadata": {
    "title": "CyberTriage - Forensic Collection (Tag-Driven)",
    "description": "Tag-driven forensic collection. Analyst tags devices in MDE with TargetDeviceTag (default 'ForensicCollect'). XDR automation triggers this Logic App; it finds tagged devices that are online and runs CyberTriage on each via Live Response. Offline tagged devices are skipped this run; the tag persists so they're picked up next run.",
    "author": "Security Engineering"
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "TargetDeviceTag": {
      "type": "string",
      "defaultValue": "ForensicCollect",
      "metadata": { "description": "MDE device tag that flags a device for forensic collection." }
    },
    "DestinationStorageAccountName": {
      "type": "string",
      "metadata": { "description": "Storage account for collected forensic output. A short-lived SAS URL is generated at runtime and passed to the MDE Live Response script." }
    },
    "SasBrokerUrl": {
      "type": "securestring",
      "metadata": { "description": "HTTPS endpoint that returns a user-delegation SAS URL as JSON: { sasUrl, expiresOnUtc }. For Azure Functions, use the full function URL including code= if function-key auth is used." }
    },
    "SasExpiryMinutes": {
      "type": "int",
      "defaultValue": 1440,
      "metadata": { "description": "Runtime SAS lifetime in minutes. Keep long enough for full Cyber Triage collection and upload to complete." }
    },
    "SasPermissions": {
      "type": "string",
      "defaultValue": "racwdl",
      "metadata": { "description": "Container SAS permissions in Azure canonical order. Default is read/add/create/write/delete/list to match validated Cyber Triage uploader behavior; reduce after customer-specific testing if possible." }
    },
    "NotificationEmail": {
      "type": "string",
      "defaultValue": "",
      "metadata": { "description": "Optional email address for completion notifications. Leave blank if email notification is not needed." }
    },
    "SentinelWorkspaceResourceGroup": {
      "type": "string"
    },
    "SentinelWorkspaceName": {
      "type": "string"
    },
    "SentinelWorkspaceCustomerId": {
      "type": "string"
    },
    "SentinelWorkspaceSubscriptionId": {
      "type": "string",
      "defaultValue": "[subscription().subscriptionId]"
    },
    "WatchlistAlias": {
      "type": "string",
      "defaultValue": "ForensicCollectQueue"
    },
    "DefenderApiBaseUri": {
      "type": "string",
      "defaultValue": "https://api.securitycenter.microsoft.com",
      "metadata": { "description": "Microsoft Defender for Endpoint API base URI." }
    },
    "DefenderApiAudience": {
      "type": "string",
      "defaultValue": "https://securitycenter.onmicrosoft.com/windowsatpservice",
      "metadata": { "description": "Managed identity token audience/resource for Microsoft Defender for Endpoint API calls." }
    },
    "ArmBaseUri": {
      "type": "string",
      "defaultValue": "https://management.azure.com",
      "metadata": { "description": "Azure Resource Manager base URI used by raw HTTP actions." }
    },
    "ArmAudience": {
      "type": "string",
      "defaultValue": "https://management.azure.com/",
      "metadata": { "description": "Managed identity token audience/resource for Azure Resource Manager calls." }
    }
  },
  "variables": {
    "PlaybookName": "CyberTriage-LiveResponse-Collection",
    "CyberTriageExeName": "CyberTriageCollector.exe",
    "CollectionScriptName": "Run-CyberTriage.ps1",
    "CollectionType": "fast",
    "OutputPath": "C:\\Windows\\Temp\\cttout.json.enc",
    "DestinationContainerName": "cybertriage-results",
    "OnlineThresholdMinutes": 30,
    "office365ConnectionName": "[concat('office365-', variables('PlaybookName'))]",
    "office365ConnectionId": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'office365')]",
    "sentinelConnectionName": "[concat('azuresentinel-', variables('PlaybookName'))]",
    "sentinelConnectionId": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'azuresentinel')]",
    "defenderApiBaseUri": "[parameters('DefenderApiBaseUri')]",
    "defenderApiAudience": "[parameters('DefenderApiAudience')]",
    "armBaseUri": "[parameters('ArmBaseUri')]",
    "armAudience": "[parameters('ArmAudience')]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('sentinelConnectionName')]",
      "location": "[parameters('location')]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('sentinelConnectionName')]",
        "api": { "id": "[variables('sentinelConnectionId')]" },
        "parameterValueType": "Alternative"
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('office365ConnectionName')]",
      "location": "[parameters('location')]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('office365ConnectionName')]",
        "api": { "id": "[variables('office365ConnectionId')]" }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[variables('PlaybookName')]",
      "location": "[parameters('location')]",
      "tags": {
        "purpose": "security-playbook",
        "tool": "cybertriage",
        "component": "forensic-collection",
        "trigger-model": "tag-driven"
      },
      "identity": { "type": "SystemAssigned" },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('sentinelConnectionName'))]",
        "[resourceId('Microsoft.Web/connections', variables('office365ConnectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "3.0.0.0",
          "parameters": {
            "$connections": { "type": "Object", "defaultValue": {} },
            "TargetDeviceTag":            { "type": "String", "defaultValue": "[parameters('TargetDeviceTag')]" },
            "CollectionScriptName":       { "type": "String", "defaultValue": "[variables('CollectionScriptName')]" },
            "CyberTriageExeName":         { "type": "String", "defaultValue": "[variables('CyberTriageExeName')]" },
            "CollectionType":             { "type": "String", "defaultValue": "[variables('CollectionType')]" },
            "OutputPath":                 { "type": "String", "defaultValue": "[variables('OutputPath')]" },
            "DestinationContainerName":   { "type": "String", "defaultValue": "[variables('DestinationContainerName')]" },
            "DestinationStorageAccountName": { "type": "String",       "defaultValue": "[parameters('DestinationStorageAccountName')]" },
            "SasBrokerUrl":               { "type": "SecureString", "defaultValue": "[parameters('SasBrokerUrl')]" },
            "SasExpiryMinutes":           { "type": "Int",    "defaultValue": "[parameters('SasExpiryMinutes')]" },
            "SasPermissions":             { "type": "String", "defaultValue": "[parameters('SasPermissions')]" },
            "OnlineThresholdMinutes":     { "type": "Int",    "defaultValue": "[variables('OnlineThresholdMinutes')]" },
            "NotificationEmail":          { "type": "String", "defaultValue": "[parameters('NotificationEmail')]" },
            "WorkspaceSubscriptionId":    { "type": "String", "defaultValue": "[parameters('SentinelWorkspaceSubscriptionId')]" },
            "WorkspaceResourceGroup":     { "type": "String", "defaultValue": "[parameters('SentinelWorkspaceResourceGroup')]" },
            "WorkspaceName":              { "type": "String", "defaultValue": "[parameters('SentinelWorkspaceName')]" },
            "WorkspaceCustomerId":        { "type": "String", "defaultValue": "[parameters('SentinelWorkspaceCustomerId')]" },
            "WatchlistAlias":             { "type": "String", "defaultValue": "[parameters('WatchlistAlias')]" },
            "DefenderApiBaseUri":         { "type": "String", "defaultValue": "[variables('defenderApiBaseUri')]" },
            "DefenderApiAudience":        { "type": "String", "defaultValue": "[variables('defenderApiAudience')]" },
            "ArmBaseUri":                 { "type": "String", "defaultValue": "[variables('armBaseUri')]" },
            "ArmAudience":                { "type": "String", "defaultValue": "[variables('armAudience')]" }
          },
          "triggers": {
            "manual": {
              "type": "Request",
              "kind": "Http",
              "inputs": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "IncidentId": { "type": "string" },
                    "TagName": { "type": "string" },
                    "WatchlistItemId": { "type": "string" },
                    "MdatpDeviceId": { "type": "string" },
                    "DeviceName": { "type": "string" },
                    "EnqueuedTime": { "type": "string" },
                    "Attempts": { "type": "string" }
                  }
                }
              }
            }
          },
          "actions": {
            "Init_TagName": {
              "type": "InitializeVariable",
              "runAfter": {},
              "inputs": { "variables": [{ "name": "TagName", "type": "string", "value": "@{coalesce(triggerBody()?['TagName'], parameters('TargetDeviceTag'))}" }] }
            },
            "Init_CollectionType": {
              "type": "InitializeVariable",
              "runAfter": { "Init_TagName": ["Succeeded"] },
              "inputs": { "variables": [{ "name": "CollectionTypeRun", "type": "string", "value": "@parameters('CollectionType')" }] }
            },
            "Init_IncidentId": {
              "type": "InitializeVariable",
              "runAfter": { "Init_CollectionType": ["Succeeded"] },
              "inputs": { "variables": [{ "name": "IncidentId", "type": "string", "value": "@{coalesce(triggerBody()?['IncidentId'], '')}" }] }
            },
            "Init_DeviceId": {
              "type": "InitializeVariable",
              "runAfter": { "Init_IncidentId": ["Succeeded"] },
              "inputs": { "variables": [{ "name": "DeviceId", "type": "string", "value": "" }] }
            },
            "Query_Tagged_Devices": {
              "type": "Http",
              "runAfter": { "Init_DeviceId": ["Succeeded"] },
              "inputs": {
                "method": "GET",
                "uri": "@{concat(parameters('DefenderApiBaseUri'), '/api/machines')}",
                "authentication": { "type": "ManagedServiceIdentity", "audience": "@parameters('DefenderApiAudience')" },
                "queries": {
                  "$filter": "@{if(empty(triggerBody()?['MdatpDeviceId']), concat('machineTags/any(t:t eq ''', variables('TagName'), ''') and onboardingStatus eq ''Onboarded'''), concat('id eq ''', triggerBody()?['MdatpDeviceId'], ''' and onboardingStatus eq ''Onboarded'''))}",
                  "$select": "id,computerDnsName,osPlatform,healthStatus,lastSeen,machineTags"
                }
              }
            },
            "Parse_Tagged_Devices": {
              "type": "ParseJson",
              "runAfter": { "Query_Tagged_Devices": ["Succeeded"] },
              "inputs": {
                "content": "@body('Query_Tagged_Devices')",
                "schema": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "computerDnsName": { "type": "string" },
                          "osPlatform": { "type": "string" },
                          "healthStatus": { "type": "string" },
                          "lastSeen": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            },
            "If_Any_Tagged_Devices": {
              "type": "If",
              "runAfter": { "Parse_Tagged_Devices": ["Succeeded"] },
              "expression": { "and": [{ "greater": ["@length(body('Parse_Tagged_Devices')?['value'])", 0] }] },
              "actions": {
                "For_Each_Tagged_Device": {
                  "type": "Foreach",
                  "runAfter": {},
                  "foreach": "@body('Parse_Tagged_Devices')?['value']",
                  "actions": {
                    "Set_DeviceId": {
                      "type": "SetVariable",
                      "runAfter": {},
                      "inputs": { "name": "DeviceId", "value": "@{items('For_Each_Tagged_Device')?['id']}" }
                    },
                    "Query_Active_Live_Response_Actions": {
                      "type": "Http",
                      "runAfter": { "Set_DeviceId": ["Succeeded"] },
                      "inputs": {
                        "method": "GET",
                        "uri": "@{concat(parameters('DefenderApiBaseUri'), '/api/machineactions')}",
                        "authentication": { "type": "ManagedServiceIdentity", "audience": "@parameters('DefenderApiAudience')" },
                        "queries": {
                          "$filter": "@{concat('machineId eq ''', variables('DeviceId'), ''' and type eq ''LiveResponse'' and (status eq ''Pending'' or status eq ''InProgress'')')}",
                          "$top": "1"
                        }
                      }
                    },
                    "Parse_Active_Live_Response_Actions": {
                      "type": "ParseJson",
                      "runAfter": { "Query_Active_Live_Response_Actions": ["Succeeded"] },
                      "inputs": {
                        "content": "@body('Query_Active_Live_Response_Actions')",
                        "schema": {
                          "type": "object",
                          "properties": {
                            "value": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "id": { "type": "string" },
                                  "type": { "type": "string" },
                                  "status": { "type": "string" },
                                  "creationDateTimeUtc": { "type": "string" },
                                  "lastUpdateDateTimeUtc": { "type": "string" }
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "If_Active_Live_Response_Exists": {
                      "type": "If",
                      "runAfter": { "Parse_Active_Live_Response_Actions": ["Succeeded"] },
                      "expression": { "and": [{ "greater": ["@length(body('Parse_Active_Live_Response_Actions')?['value'])", 0] }] },
                      "actions": {
                        "Update_Watchlist_Blocked_If_Queued": {
                          "type": "If",
                          "runAfter": {},
                          "expression": { "and": [{ "not": { "equals": ["@empty(triggerBody()?['WatchlistItemId'])", true] } }] },
                          "actions": {
                            "Update_Watchlist_Blocked": {
                              "type": "Http",
                              "runAfter": {},
                              "inputs": {
                                "method": "PUT",
                                "uri": "@{concat(parameters('ArmBaseUri'), '/subscriptions/', parameters('WorkspaceSubscriptionId'), '/resourceGroups/', parameters('WorkspaceResourceGroup'), '/providers/Microsoft.OperationalInsights/workspaces/', parameters('WorkspaceName'), '/providers/Microsoft.SecurityInsights/watchlists/', parameters('WatchlistAlias'), '/watchlistItems/', triggerBody()?['WatchlistItemId'], '?api-version=2023-11-01')}",
                                "headers": { "Content-Type": "application/json" },
                                "authentication": { "type": "ManagedServiceIdentity", "audience": "@parameters('ArmAudience')" },
                                "body": {
                                  "properties": {
                                    "itemsKeyValue": {
                                      "MdatpDeviceId": "@{variables('DeviceId')}",
                                      "DeviceName": "@{coalesce(triggerBody()?['DeviceName'], items('For_Each_Tagged_Device')?['computerDnsName'])}",
                                      "IncidentId": "@{coalesce(variables('IncidentId'), '')}",
                                      "TagName": "@{variables('TagName')}",
                                      "EnqueuedTime": "@{coalesce(triggerBody()?['EnqueuedTime'], utcNow())}",
                                      "Attempts": "@{string(add(int(coalesce(triggerBody()?['Attempts'], '0')), 1))}",
                                      "Status": "BlockedLiveResponse",
                                      "LastAttemptUtc": "@{utcNow()}",
                                      "RetryAfterUtc": "@{addHours(utcNow(), 2)}",
                                      "BlockedActionId": "@{first(body('Parse_Active_Live_Response_Actions')?['value'])?['id']}",
                                      "LastError": "@{concat('Active Live Response action already exists: ', first(body('Parse_Active_Live_Response_Actions')?['value'])?['id'])}"
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "else": { "actions": {} }
                        },
                        "Active_Live_Response_Summary": {
                          "type": "Compose",
                          "runAfter": { "Update_Watchlist_Blocked_If_Queued": ["Succeeded"] },
                          "inputs": {
                            "status": "BlockedLiveResponse",
                            "deviceId": "@{variables('DeviceId')}",
                            "activeActionId": "@{first(body('Parse_Active_Live_Response_Actions')?['value'])?['id']}",
                            "retryAfterUtc": "@{addHours(utcNow(), 2)}"
                          }
                        }
                      },
                      "else": {
                        "actions": {
                          "Generate_CyberTriage_Sas": {
                            "type": "Http",
                            "runAfter": {},
                            "inputs": {
                              "method": "POST",
                              "uri": "@parameters('SasBrokerUrl')",
                              "headers": { "Content-Type": "application/json" },
                              "body": {
                                "storageAccountName": "@{parameters('DestinationStorageAccountName')}",
                                "containerName": "@{parameters('DestinationContainerName')}",
                                "permissions": "@{parameters('SasPermissions')}",
                                "ttlMinutes": "@parameters('SasExpiryMinutes')",
                                "correlationId": "@{workflow().run.name}",
                                "deviceId": "@{variables('DeviceId')}",
                                "deviceName": "@{items('For_Each_Tagged_Device')?['computerDnsName']}"
                              }
                            },
                            "runtimeConfiguration": {
                              "secureData": { "properties": [ "inputs", "outputs" ] }
                            }
                          },
                          "Run_LR_Collection": {
                            "type": "Http",
                            "runAfter": { "Generate_CyberTriage_Sas": ["Succeeded"] },
                            "inputs": {
                              "method": "POST",
                              "uri": "@{concat(parameters('DefenderApiBaseUri'), '/api/machines/', encodeURIComponent(variables('DeviceId')), '/runliveresponse')}",
                              "headers": { "Content-Type": "application/json" },
                              "authentication": { "type": "ManagedServiceIdentity", "audience": "@parameters('DefenderApiAudience')" },
                              "body": {
                                "Commands": [
                                  { "type": "PutFile",   "params": [{ "key": "FileName",   "value": "@{parameters('CyberTriageExeName')}" }] },
                                  { "type": "RunScript", "params": [
                                      { "key": "ScriptName", "value": "@{parameters('CollectionScriptName')}" },
                                      { "key": "Args", "value": "@{concat('-AzureSasUrl ''', body('Generate_CyberTriage_Sas')?['sasUrl'], ''' -Profile ', variables('CollectionTypeRun'))}" }
                                    ]
                                  }
                                ],
                                "Comment": "CyberTriage @{variables('CollectionTypeRun')} (tag: @{variables('TagName')}). Collector uploads directly to blob via short-lived SAS URL. Incident: @{coalesce(variables('IncidentId'), 'N/A')}"
                              }
                            },
                            "runtimeConfiguration": {
                              "secureData": { "properties": [ "inputs" ] }
                            }
                          },
                          "Remove_Tag": {
                            "type": "Http",
                            "runAfter": { "Run_LR_Collection": ["Succeeded"] },
                            "inputs": {
                              "method": "POST",
                              "uri": "@{concat(parameters('DefenderApiBaseUri'), '/api/machines/', encodeURIComponent(items('For_Each_Tagged_Device')?['id']), '/tags')}",
                              "headers": { "Content-Type": "application/json" },
                              "authentication": { "type": "ManagedServiceIdentity", "audience": "@parameters('DefenderApiAudience')" },
                              "body": { "Value": "@{variables('TagName')}", "Action": "Remove" }
                            }
                          },
                          "Delete_Watchlist_Item_If_Queued": {
                            "type": "If",
                            "runAfter": { "Remove_Tag": ["Succeeded"] },
                            "expression": { "and": [{ "not": { "equals": ["@empty(triggerBody()?['WatchlistItemId'])", true] } }] },
                            "actions": {
                              "Delete_Watchlist_Item": {
                                "type": "ApiConnection",
                                "runAfter": {},
                                "inputs": {
                                  "host": { "connection": { "name": "@parameters('$connections')['azuresentinel']['connectionId']" } },
                                  "method": "delete",
                                  "path": "/Watchlists/subscriptions/@{encodeURIComponent(parameters('WorkspaceSubscriptionId'))}/resourceGroups/@{encodeURIComponent(parameters('WorkspaceResourceGroup'))}/workspaces/@{encodeURIComponent(parameters('WorkspaceCustomerId'))}/watchlists/@{encodeURIComponent(parameters('WatchlistAlias'))}/watchlistItem/@{encodeURIComponent(triggerBody()?['WatchlistItemId'])}"
                                }
                              }
                            },
                            "else": { "actions": {} }
                          },
                          "If_Notification_Email_Configured": {
                            "type": "If",
                            "runAfter": { "Delete_Watchlist_Item_If_Queued": ["Succeeded"] },
                            "expression": { "and": [{ "not": { "equals": ["@empty(parameters('NotificationEmail'))", true] } }] },
                            "actions": {
                              "Email_Started": {
                                "type": "ApiConnection",
                                "runAfter": {},
                                "inputs": {
                                  "host": { "connection": { "name": "@parameters('$connections')['office365']['connectionId']" } },
                                  "method": "post",
                                  "path": "/v2/Mail",
                                  "body": {
                                    "To": "@{parameters('NotificationEmail')}",
                                    "Subject": "CyberTriage Collection Started - @{items('For_Each_Tagged_Device')?['computerDnsName']}",
                                    "Body": "<h3>Forensic Collection Launched</h3><p>The Cyber Triage collector has been handed off to Defender Live Response. It runs in the background and uploads the encrypted artifact directly to blob storage with a short-lived SAS URL (typically 5&ndash;30 minutes for a workstation, longer for servers). The verification playbook will confirm successful upload separately.</p><table border='1' cellpadding='5'><tr><td><b>Device</b></td><td>@{items('For_Each_Tagged_Device')?['computerDnsName']}</td></tr><tr><td><b>Device ID</b></td><td>@{items('For_Each_Tagged_Device')?['id']}</td></tr><tr><td><b>OS</b></td><td>@{items('For_Each_Tagged_Device')?['osPlatform']}</td></tr><tr><td><b>Machine Action ID</b></td><td>@{body('Run_LR_Collection')?['id']}</td></tr><tr><td><b>Tag</b></td><td>@{variables('TagName')}</td></tr><tr><td><b>Collection Profile</b></td><td>@{variables('CollectionTypeRun')}</td></tr><tr><td><b>Incident</b></td><td>@{coalesce(variables('IncidentId'), 'N/A')}</td></tr><tr><td><b>Storage Account</b></td><td>@{parameters('DestinationStorageAccountName')}</td></tr><tr><td><b>Container</b></td><td>@{parameters('DestinationContainerName')}</td></tr><tr><td><b>SAS Expires</b></td><td>@{coalesce(body('Generate_CyberTriage_Sas')?['expiresOnUtc'], 'Runtime-generated')}</td></tr><tr><td><b>Expected Blob</b></td><td>cttout_@{items('For_Each_Tagged_Device')?['computerDnsName']}_&lt;timestamp&gt;.json.gz.enc.01</td></tr><tr><td><b>Decryption Password</b></td><td><code>infected</code> &mdash; open in Cyber Triage product</td></tr></table>",
                                    "Importance": "Normal",
                                    "IsHtml": true
                                  }
                                }
                              },
                              "Email_Started_Result": {
                                "type": "Compose",
                                "runAfter": { "Email_Started": ["Succeeded", "Failed", "Skipped", "TimedOut"] },
                                "inputs": {
                                  "status": "NotificationAttempted",
                                  "emailActionStatus": "@actions('Email_Started')?['status']"
                                }
                              }
                            },
                            "else": {
                              "actions": {
                                "Email_Skipped": {
                                  "type": "Compose",
                                  "runAfter": {},
                                  "inputs": { "status": "NotificationSkipped", "reason": "NotificationEmail is blank." }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                      }
                    },
                "Run_Summary": {
                  "type": "Compose",
                  "runAfter": { "For_Each_Tagged_Device": ["Succeeded"] },
                  "inputs": {
                    "status": "Processed",
                    "tag": "@{variables('TagName')}",
                    "deviceCount": "@length(body('Parse_Tagged_Devices')?['value'])",
                    "devices": "@body('Parse_Tagged_Devices')?['value']"
                  }
                }
              },
              "else": {
                "actions": {
                  "Log_NoDevices": {
                    "type": "Compose",
                    "runAfter": {},
                    "inputs": {
                      "status": "NoDevices",
                      "message": "No onboarded devices currently carry the tag.",
                      "tag": "@{variables('TagName')}"
                    }
                  }
                }
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "office365": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('office365ConnectionName'))]",
                "connectionName": "[variables('office365ConnectionName')]",
                "id": "[variables('office365ConnectionId')]"
              },
              "azuresentinel": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('sentinelConnectionName'))]",
                "connectionName": "[variables('sentinelConnectionName')]",
                "id": "[variables('sentinelConnectionId')]",
                "connectionProperties": {
                  "authentication": { "type": "ManagedServiceIdentity" }
                }
              }
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "logicAppName":      { "type": "string", "value": "[variables('PlaybookName')]" },
    "logicAppResourceId":{ "type": "string", "value": "[resourceId('Microsoft.Logic/workflows', variables('PlaybookName'))]" },
    "principalId":       { "type": "string", "value": "[reference(resourceId('Microsoft.Logic/workflows', variables('PlaybookName')), '2019-05-01', 'full').identity.principalId]" },
    "requiredDefenderApiPermissions": {
