{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "usgovvirginia"
    },
    "TargetDeviceTag": {
      "value": "ForensicCollect"
    },
    "DestinationStorageAccountName": {
      "value": "<gcch-evidence-storage-account-name>"
    },
    "SasBrokerUrl": {
      "value": "<secure-gcch-broker-url-do-not-commit-real-value>"
    },
    "SasExpiryMinutes": {
      "value": 1440
