{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "usgovvirginia"
    },
    "SasBrokerFunctionAppName": {
      "value": "<globally-unique-function-app-name>"
    },
    "FunctionHostStorageAccountName": {
      "value": "<globallyuniquestorageacct>"
    },
    "SasBrokerPackageUri": {
      "value": "https://raw.githubusercontent.com/Cyberlorians/CyberTriage/main/packages/SasBrokerNode.zip"
    },
    "DestinationStorageAccountName": {
      "value": "<evidence-storage-account-name>"
    },
    "TargetDeviceTag": {
      "value": "ForensicCollect"
    },
    "NotificationEmail": {
      "value": "security-team@example.us"
    },
    "SentinelWorkspaceResourceGroup": {
      "value": "<sentinel-workspace-resource-group>"
    },
    "SentinelWorkspaceName": {
      "value": "<gcch-sentinel-workspace-name>"
    },
    "SentinelWorkspaceCustomerId": {
      "value": "<workspace-guid>"
    },
    "SentinelWorkspaceSubscriptionId": {
      "value": "<subscription-guid>"
    },
    "WatchlistAlias": {
      "value": "ForensicCollectQueue"
    },
    "SasExpiryMinutes": {
      "value": 1440
    },
    "SasPermissions": {
      "value": "racwdl"
    },
    "PollFrequencyMinutes": {
      "value": 60
    },
    "OnlineWindowMinutes": {
      "value": 60
    },
    "DefenderApiBaseUri": {
      "value": "https://api-gov.securitycenter.microsoft.us"
    },
    "DefenderApiAudience": {
      "value": "https://api-gov.securitycenter.microsoft.us"
    },
    "ArmBaseUri": {
      "value": "https://management.usgovcloudapi.net"
    },
    "ArmAudience": {
      "value": "https://management.usgovcloudapi.net/"
    },
    "StorageBlobDnsSuffix": {
      "value": "blob.core.usgovcloudapi.net"
    },
    "StorageTokenResource": {
      "value": "https://storage.azure.com/"
    }
  }
}
